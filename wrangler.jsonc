{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ainfo",
  "main": "worker/src/tech.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "DOMAIN": "https://www.ainfo.web.id"
  }
}
