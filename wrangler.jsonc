{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ainfo",
  "main": "worker/src/tech.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "DOMAIN": "https://www.ainfo.web.id"
  },
  "d1_databases": [
    {
      "binding": "TECH_DB",
      "database_name": "ainfo-tech-cms",
      "database_id": "40413078-0c21-4f09-91aa-001ecb572ded",
      "migrations_dir": "tech-migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TECH_MEDIA",
      "bucket_name": "ainfo-media-prod"
    }
  ]
}
